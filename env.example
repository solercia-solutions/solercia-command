# Solercia Command — environment variables reference.
# All values below are already hardcoded in docker-compose.yml for the MVP,
# so the stack boots without an .env file. Override these before any non-local deployment.

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=solercia

# Backend (FastAPI)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/solercia
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-secret-change-me
# OBLIGATORIO cambiarla en producción — genera una con:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
INTEGRATIONS_FERNET_KEY=GVraOHsbm9EGeG8TDBNGc8TRZZEzPeSVIkytJ7jZGd8=

# Frontend (Angular) — API base consumed from the browser
API_BASE_URL=http://localhost:8000/api/v1
