# Solercia Command — environment variables reference.
# All values below are already hardcoded in docker-compose.yml for the MVP,
# so the stack boots without an .env file. Override these before any non-local deployment.

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=solercia

# Backend (FastAPI)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/solercia
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-secret-change-me
# OBLIGATORIA en todo ambiente y distinta en cada uno; va en .env. Genera una con:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
INTEGRATIONS_FERNET_KEY=
# Compuerta de la semilla demo (change 42-purga-datos-demo). En false, un
# arranque nuevo nunca crea ana@/carlos@/diana@ ni sus proyectos/tareas/
# sprint demo; la semilla estructural (organización "Solercia", catálogo
# RBAC, admin@solercia.com) sigue corriendo sin condición.
SEED_DEMO_DATA=false

# Puerto LLM (change 48-puerto-llm). `fake` no toca la red y es el defecto.
LLM_PROVIDER=fake
# Ollama local: desde el host usa localhost; desde el contenedor, host.docker.internal.
# En Linux `host.docker.internal` no resuelve (el compose no declara extra_hosts):
# la sonda responderá reachability=unreachable con motivo legible.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:9b-q4_K_M     # alternativas locales: gpt-oss:20b, qwen3.6:35b-a3b
# LLM_JSON_MODE=json_object       # llama.cpp: json_schema_llamacpp · LM Studio: json_schema_openai
# Nube (modo de excepción: saca contenido de la máquina):
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-opus-5
# LLM_API_KEY=

# Solercia Connect (runtime local que sostiene la sesión de Microsoft de la
# persona). Command lo alcanza por HTTP en loopback: desde el contenedor,
# `host.docker.internal`; desde el host, `http://127.0.0.1:8765`. La URL debe
# estar en SOLERCIA_CONNECT_BASE_URL_ALLOWLIST (por defecto incluye ambas).
# La llave es la del runtime (`X-Solercia-Connect-Key`), nunca una credencial
# del proveedor; vacía = conexión no configurada (la API responde 422).
SOLERCIA_CONNECT_BASE_URL=http://host.docker.internal:8765
SOLERCIA_CONNECT_API_KEY=
SOLERCIA_CONNECT_DEFAULT_TARGET=outlook

# Sincronización del checklist (C01). Ruta o slug vacíos = deshabilitada.
# La carpeta TAREAS solo se LISTA (nombres T-NN), nunca se lee su contenido.
# Con UPDATE_EXISTING=true el CSV manda sobre los campos que importa.
CHECKLIST_SYNC_PATH=
CHECKLIST_SYNC_TAREAS_ROOT=
CHECKLIST_SYNC_ORG_SLUG=
CHECKLIST_SYNC_ACTOR_EMAIL=
CHECKLIST_SYNC_UPDATE_EXISTING=true

# Sincronización programada (C02): checklist → ingesta → clasificación a cada
# hora HH:MM de SCHEDULED_SYNC_TIMES en la zona SCHEDULED_SYNC_TZ. Bandera
# propia, independiente de STARTUP_PROFILE y de EMAIL_ENABLED: en
# local_restricted solo se registran estos trabajos (sin alertas ni correo).
SCHEDULED_SYNC_ENABLED=false
SCHEDULED_SYNC_TIMES=06:00,23:59
SCHEDULED_SYNC_TZ=America/Bogota
SCHEDULED_SYNC_MISFIRE_GRACE_SECONDS=3600

# Clasificación de hilos de correo (C05), paso 3 de la sincronización: propone
# (no cambia tareas). Ventana en días, máximo de hilos por corrida, máximo de
# caracteres por hilo enviados al modelo y top-k de tareas candidatas.
# AI_DEFAULT_NUM_CTX: contexto pedido al preset local por defecto (menos RAM).
RECONCILIATION_ENABLED=true
RECONCILIATION_WINDOW_DAYS=7
RECONCILIATION_MAX_THREADS_PER_RUN=40
RECONCILIATION_MAX_THREAD_CHARS=6000
RECONCILIATION_TOP_K=5
# Candidatas por hilo del canal v2 (E07b: fusión RRF de BM25 y embeddings).
RECONCILIATION_V2_TOP_K=8
RECONCILIATION_LLM_MAX_TOKENS=600
# Canal v2 (E03): reglas versionadas por organización (archivo o carpeta con <slug>.json).
RECONCILIATION_CHANNEL=v1
RECONCILIATION_RULES_PATH=
AI_DEFAULT_NUM_CTX=8192

# Inicio de sesión con Keycloak (OIDC). Apagado por defecto. Para probarlo en
# local con el Keycloak de desarrollo: `docker compose --profile sso up -d keycloak`
# y descomenta este bloque (valores del realm dev/keycloak/solercia-dev-realm.json).
# En una entidad, TI registra un cliente propio para Solercia Command con la
# redirect_uri exacta del backend y entrega el issuer, el client_id y el secreto.
# SSO_ENABLED=true
# SSO_AUTO_PROVISION=false
# SSO_POST_LOGIN_REDIRECT=http://localhost:4242/auth/callback
# OIDC_KEYCLOAK_ISSUER=http://keycloak.localhost:8180/realms/solercia-dev
# OIDC_KEYCLOAK_CLIENT_ID=solercia-command
# OIDC_KEYCLOAK_CLIENT_SECRET=solercia-dev-client-secret
# OIDC_KEYCLOAK_REDIRECT_URI=http://localhost:8081/api/v1/auth/sso/keycloak/callback

# Frontend (Angular) — API base consumed from the browser
API_BASE_URL=http://localhost:8000/api/v1
